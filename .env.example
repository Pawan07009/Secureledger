# ==============================================================================
# SecureLedger - Real SMS Gateway & Production Configuration
# ==============================================================================
# Rename this file to .env to activate real SMS delivery to your phone.

# ------------------------------------------------------------------------------
# OPTION 1: Fast2SMS (Easiest for Indian Numbers - Instant OTP Route)
# ------------------------------------------------------------------------------
# 1. Sign up for free at: https://www.fast2sms.com/
# 2. Go to "Dev API" tab -> Copy your API Authorization Key.
# 3. Paste it below:
FAST2SMS_API_KEY=

# ------------------------------------------------------------------------------
# OPTION 2: Twilio Messages API (Global & India)
# ------------------------------------------------------------------------------
# 1. Sign up at: https://www.twilio.com/
# 2. Copy Account SID, Auth Token, and Twilio phone number:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ------------------------------------------------------------------------------
# OPTION 3: MSG91 (India TRAI DLT Compliant)
# ------------------------------------------------------------------------------
# 1. Sign up at: https://msg91.com/
# 2. Provide Auth Key and approved Flow Template ID:
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
